<mxfile host="app.diagrams.net">
  <diagram id="medallion" name="Arquitectura Medallion GCP">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Título -->
        <mxCell id="title" value="&lt;b&gt;GCP Medallion Data Platform&lt;/b&gt;&lt;br&gt;Terraform · Cloud Functions Gen2 · Eventarc · BigQuery · Cloud Workflows · GitHub Actions (WIF)" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="450" y="10" width="1000" height="50" as="geometry" />
        </mxCell>

        <!-- Terraform / GCP boundary -->
        <mxCell id="gcp" value="Proyecto Google Cloud · aprovisionado 100% con Terraform (44 recursos)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#7B42BC;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#7B42BC;" vertex="1" parent="1">
          <mxGeometry x="240" y="80" width="1600" height="620" as="geometry" />
        </mxCell>

